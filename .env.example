########################################
# Gateway Configuration
########################################
PORT=8080

########################################
# Database (PostgreSQL)
########################################
DB_NAME=matcha
DB_USER=postgres
DB_PASSWORD=changeme

########################################
# Redis Configuration
########################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

########################################
# JWT Configuration
########################################
JWT_SECRET=<generate-a-secure-random-string>
JWT_REFRESH_SECRET=<generate-a-different-secure-random-string>
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h

########################################
# PgAdmin Configuration
########################################
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

########################################
# Service URLs - Docker internal network
########################################
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
MATCH_SERVICE_URL=http://match-service:8003
CHAT_SERVICE_URL=http://chat-service:8004
NOTIFY_SERVICE_URL=http://notify-service:8005
MEDIA_SERVICE_URL=http://media-service:8006

########################################
# Local development override examples
########################################
# AUTH_SERVICE_URL=http://localhost:8001
# USER_SERVICE_URL=http://localhost:8002
# MATCH_SERVICE_URL=http://localhost:8003
# CHAT_SERVICE_URL=http://localhost:8004
# NOTIFY_SERVICE_URL=http://localhost:8005
# MEDIA_SERVICE_URL=http://localhost:8006

########################################
# Frontend (Vite) variables
########################################
VITE_API_URL=https://localhost:8443/api
VITE_HOSTNAME=localhost

########################################
# SMTP Configuration
########################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>

########################################
# Email settings
########################################
FROM_EMAIL=noreply@example.com
FROM_NAME=matcha

########################################
# Stripe Payment Service Configuration
########################################
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>
STRIPE_PRICE_MENSUEL=price_your_monthly_price_id_here
STRIPE_PRICE_ANNUEL=price_your_yearly_price_id_here
STRIPE_SUCCESS_URL=http://localhost:5173/app/premium?success=true
STRIPE_CANCEL_URL=http://localhost:5173/app/premium?canceled=true

########################################
# Internal API Communication
########################################
INTERNAL_API_KEY=<generate-a-secure-api-key>

########################################
# Rate Limiting
########################################
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100

########################################
# Development Settings
########################################
LOG_LEVEL=debug
CLEANUP_INTERVAL_MINUTES=30
ENABLE_DETAILED_LOGS=true
METRICS_ENABLED=true
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_MINUTES=1
USE_REDIS_CACHE=true